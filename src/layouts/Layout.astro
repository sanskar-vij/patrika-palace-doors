---
import { content } from '../data/content';
import PalaceEntrance from '../components/PalaceEntrance.astro';
import '../styles/styles.css';
import '../styles/opening.css';
import '../styles/refinements.css';
import '../styles/reference-envelope.css';
import '../styles/spacing.css';
import '../styles/events.css';
import '../styles/entrance.css';
import '../styles/typography.css';
import '../styles/countdown.css';
const title = content.bride + ' & ' + content.groom + ' · A Palace Journey';
const description = 'Join ' + content.bride + ' and ' + content.groom + ' on ' + content.dateLabel + ' in ' + content.location + '.';
const base = import.meta.env.BASE_URL;
// Each build gets fresh script URLs so browsers do not reuse an older release.
const assetVersion = Date.now().toString(36);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f6eedc" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    {content.entrance?.enabled && <link rel="preload" as="image" href={base + content.entrance.background.replace(/^\/+/, '')} />}
    <!-- Ordered external scripts also work on static hosting. -->
    <script is:inline src={base + 'content.js?v=' + assetVersion} defer></script>
    <script is:inline src={base + 'app.js?v=' + assetVersion} defer></script>
    <script is:inline src={base + 'foliage.js?v=' + assetVersion} defer></script>
  </head>
  <body class:list={{ 'has-palace-intro': content.entrance?.enabled }}>
    <PalaceEntrance />
    <div id="invitation-site">
    <slot />
    <button class="music-toggle" type="button" hidden aria-label="Play music" aria-pressed="false">
      <span class="music-icon" aria-hidden="true"><svg viewBox="0 0 40 40" width="24" height="24"><circle cx="20" cy="20" r="17" fill="#342b29" stroke="#b68d57" stroke-width="2"/><circle cx="20" cy="20" r="11" fill="#f6eedc" stroke="#b68d57" stroke-width="2"/><path d="M20 9v22M9 20h22M12 12l16 16M12 28l16-16" stroke="#b68d57" stroke-width="2"/><circle cx="20" cy="20" r="4" fill="#702c3b"/></svg></span>
      <span data-music-label>Play music</span>
    </button>
    </div>
    <noscript><style is:inline>.palace-entrance { display:none !important } body.has-palace-intro { overflow:auto } body.has-palace-intro #invitation-site { visibility:visible }</style><p>This invitation needs JavaScript for its animations and music.</p></noscript>
  </body>
</html>

